# Copy to .env. Connection credentials follow INSIGHTS_CONN_<NAME>_<KEY>. The SDK resolves every
# connection declared in platform.toml from these at startup and fails fast if any is missing.
# Values here are what the fixtures expect; nothing is real.

INSIGHTS_CONN_WAREHOUSE_URL=sqlite+aiosqlite:///.local/warehouse.db
INSIGHTS_CONN_HR_API_URL=http://hr-api.fixture
INSIGHTS_CONN_HR_API_TOKEN=fixture-token

# The app's own database, used when platform.toml has [database] enabled = true. SQLite is the
# fixture; the SDK creates the schema from the models at startup. Against Postgres nothing is
# created for you: run `insights db upgrade`.
INSIGHTS_DB_URL=sqlite+aiosqlite:///.local/owned.db

# With `docker compose --profile postgres up` the same variables point at the container instead:
# INSIGHTS_CONN_WAREHOUSE_URL=postgresql+psycopg://insights:insights@localhost:5432/warehouse  # pragma: allowlist secret
# INSIGHTS_DB_URL=postgresql+psycopg://people_analytics_comp:people-analytics-comp@localhost:5432/people_analytics_comp  # pragma: allowlist secret

# Empty means console export. Set to an OTLP/HTTP collector (e.g. http://localhost:4318) to ship
# logs, metrics, and traces out of process.
OTEL_EXPORTER_OTLP_ENDPOINT=
