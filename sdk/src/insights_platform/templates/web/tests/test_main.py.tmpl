from __PKG__.main import app

from insights_platform.testing import client_for, headers_for


def test_root_is_public() -> None:
    with client_for(app) as client:
        assert client.get("/api").json() == {"app": "__NAME__"}


def test_headcount_requires_the_owning_team() -> None:
    with client_for(app) as client:
        assert client.get("/api/headcount").status_code == 401
        other = headers_for("someone", team="not-__TEAM__")
        assert client.get("/api/headcount", headers=other).status_code == 403
        owner = headers_for("someone", team="__TEAM__")
        response = client.get("/api/headcount", headers=owner)
        assert response.status_code == 200
        assert {"team", "month", "count"} <= set(response.json()[0])


def test_healthz_needs_no_headers() -> None:
    with client_for(app) as client:
        assert client.get("/healthz").status_code == 200
