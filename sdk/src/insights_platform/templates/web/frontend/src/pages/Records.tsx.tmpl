import { useEffect, useState } from "react";

import { fetchRecords, type HeadcountRecord } from "../api/client";
import { RecordsTable } from "../components/RecordsTable";

type State =
  | { status: "loading" }
  | { status: "error"; message: string }
  | { status: "ready"; records: HeadcountRecord[] };

export function Records() {
  const [state, setState] = useState<State>({ status: "loading" });

  useEffect(() => {
    let cancelled = false;
    fetchRecords()
      .then((records) => {
        if (!cancelled) {
          setState({ status: "ready", records });
        }
      })
      .catch((error: unknown) => {
        if (!cancelled) {
          const message = error instanceof Error ? error.message : String(error);
          setState({ status: "error", message });
        }
      });
    return () => {
      cancelled = true;
    };
  }, []);

  if (state.status === "loading") {
    return <p role="status">Loading records…</p>;
  }
  if (state.status === "error") {
    return <p role="alert">Could not load records: {state.message}</p>;
  }
  return (
    <section>
      <h1>Records</h1>
      <RecordsTable records={state.records} />
    </section>
  );
}
